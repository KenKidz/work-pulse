{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workpulse.dev/contracts/cdc/change-envelope.v1.json",
  "title": "WorkPulse CDC change envelope v1",
  "description": "Debezium change envelope for one captured row change on `workpulse.cdc.<table>`. Captured columns are restricted to identifiers, state and timestamps (`.ai/security.md`); row shapes live under `contracts/cdc/rows/`.",
  "type": "object",
  "required": [
    "before",
    "after",
    "op",
    "source",
    "ts_ms"
  ],
  "additionalProperties": false,
  "properties": {
    "before": {
      "type": [
        "object",
        "null"
      ],
      "description": "Row image before the change (Debezium `before`). With column include filtering Debezium may omit it (null) or fill non-key captured columns with defaults; the sink uses the post-image and drops deletes, so it is never a projection input. Null for create/read/truncate."
    },
    "after": {
      "type": [
        "object",
        "null"
      ],
      "description": "Row image after the change (Debezium `after`), matching the per-table row schema under `contracts/cdc/rows/`. Null for delete/truncate."
    },
    "op": {
      "type": "string",
      "enum": [
        "c",
        "u",
        "d",
        "r",
        "t"
      ],
      "description": "Operation: create, update, delete, snapshot read, truncate. The sink drops `d`/`t` and never deletes projection rows."
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "ts_ms": {
      "type": "integer",
      "minimum": 0,
      "description": "Debezium processing timestamp in epoch milliseconds. Projection versioning uses `source.ts_ms` instead \u2014 never ingest wall clock."
    },
    "transaction": {
      "type": [
        "object",
        "null"
      ],
      "description": "Optional Debezium transaction metadata; not used by the pipeline."
    },
    "ts_us": {
      "type": "integer",
      "minimum": 0,
      "description": "Debezium processing timestamp in epoch microseconds (optional)."
    },
    "ts_ns": {
      "type": "integer",
      "minimum": 0,
      "description": "Debezium processing timestamp in epoch nanoseconds (optional)."
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "op"
        ],
        "properties": {
          "op": {
            "const": "c"
          }
        }
      },
      "then": {
        "properties": {
          "before": {
            "type": "null"
          },
          "after": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "op"
        ],
        "properties": {
          "op": {
            "const": "u"
          }
        }
      },
      "then": {
        "properties": {
          "before": {
            "type": [
              "object",
              "null"
            ]
          },
          "after": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "op"
        ],
        "properties": {
          "op": {
            "const": "d"
          }
        }
      },
      "then": {
        "properties": {
          "before": {
            "type": [
              "object",
              "null"
            ]
          },
          "after": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "op"
        ],
        "properties": {
          "op": {
            "const": "r"
          }
        }
      },
      "then": {
        "properties": {
          "before": {
            "type": "null"
          },
          "after": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "op"
        ],
        "properties": {
          "op": {
            "const": "t"
          }
        }
      },
      "then": {
        "properties": {
          "before": {
            "type": "null"
          },
          "after": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "ts_ms",
        "lsn",
        "snapshot",
        "db",
        "schema",
        "table"
      ],
      "additionalProperties": true,
      "description": "Debezium source metadata. Extra connector fields (version, connector, name, sequence, txId, xmin, ...) are allowed by design \u2014 the pinned fields are the pipeline contract.",
      "properties": {
        "ts_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "Source transaction commit timestamp in epoch milliseconds \u2014 the projection row's `updated_at`."
        },
        "lsn": {
          "type": "integer",
          "minimum": 0,
          "description": "PostgreSQL log sequence number of the change; the `(commit_ts, lsn)` tie-breaker fallback."
        },
        "snapshot": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "true",
            "false",
            "last",
            "first",
            "first_in_data_collection",
            "last_in_data_collection",
            null
          ],
          "description": "Debezium snapshot marker: `true`/`first` while a snapshot is in progress, `first_in_data_collection`/`last_in_data_collection` for the first/last row of one table's snapshot data, `last` for the final snapshot row, `false` when streaming. Null when the source does not report it."
        },
        "db": {
          "type": "string",
          "minLength": 1,
          "description": "Source database name."
        },
        "schema": {
          "type": "string",
          "minLength": 1,
          "description": "Source schema name (`public` for the WorkPulse OLTP tables)."
        },
        "table": {
          "type": "string",
          "enum": [
            "employees",
            "employments",
            "attendance_records",
            "overtime_requests",
            "leave_requests",
            "leave_types"
          ],
          "description": "Captured table; decides which row schema applies to `after`."
        },
        "version": {
          "type": "string",
          "description": "Debezium version (informational)."
        },
        "connector": {
          "type": "string",
          "description": "Debezium connector plugin, e.g. `postgresql` (informational)."
        },
        "name": {
          "type": "string",
          "description": "Debezium logical connector name (informational)."
        },
        "sequence": {
          "type": [
            "string",
            "null"
          ],
          "description": "Debezium change sequence (informational)."
        },
        "txId": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Source transaction id (informational)."
        },
        "xmin": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Source transaction xmin (informational)."
        }
      }
    }
  }
}
