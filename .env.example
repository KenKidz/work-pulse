# Copy to .env (gitignored) and adjust. Every value has a safe dev default.

# --- PostgreSQL (docker compose) ---
POSTGRES_USER=workpulse
POSTGRES_PASSWORD=workpulse
POSTGRES_DB=workpulse

# --- apps/api ---
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://workpulse:workpulse@localhost:5432/workpulse
# Override CORS with a JSON list if needed:
# CORS_ORIGINS=["http://localhost:3000"]

# --- apps/web ---
NEXT_PUBLIC_API_URL=http://localhost:8000