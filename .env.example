# WorkPulse — environment template (every `app.config.Settings` key).
#
# The API and workers read `apps/api/.env` (they run from `apps/api`):
#   cp .env.example apps/api/.env
# Docker Compose also reads a repo-root `.env` for its variable substitution.
# Never commit a real `.env`; only this example is tracked.

# --- Application ---
APP_NAME="WorkPulse API"
VERSION=0.1.0
ENVIRONMENT=development
# JSON list of allowed browser origins.
CORS_ORIGINS=["http://localhost:3000"]

# --- PostgreSQL ---
# Dev database (`make db-up`) and the throwaway test database (`make db-test-up`).
DATABASE_URL=postgresql+asyncpg://workpulse:workpulse@localhost:5432/workpulse
DATABASE_TEST_URL=postgresql+asyncpg://workpulse:workpulse@localhost:5433/workpulse_test

# --- Redis (Phase 2 realtime fan-out; `make redis-up`) ---
REDIS_URL=redis://localhost:6379/0

# --- Kafka / outbox relay (Phase 3; `make kafka-up`, ADR 0012) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_EVENTS_TOPIC=workpulse.events
KAFKA_EVENTS_TOPIC_PARTITIONS=1
RELAY_BATCH_SIZE=100
RELAY_POLL_SECONDS=1.0
RELAY_BACKOFF_BASE_SECONDS=1.0
RELAY_BACKOFF_MAX_SECONDS=30.0

# --- Realtime consumer (`make dev-realtime`, ADR 0013) ---
REALTIME_CONSUMER_GROUP=workpulse-realtime
REALTIME_POLL_SECONDS=1.0
REALTIME_BACKOFF_BASE_SECONDS=1.0
REALTIME_BACKOFF_MAX_SECONDS=30.0

# --- Notifications consumer + delivery (ADR 0015; worker + make target land in T5) ---
NOTIFICATIONS_CONSUMER_GROUP=workpulse-notifications
NOTIFICATIONS_POLL_SECONDS=1.0
NOTIFICATIONS_BACKOFF_BASE_SECONDS=1.0
NOTIFICATIONS_BACKOFF_MAX_SECONDS=30.0
# Provider attempts per channel (successes included) before `failed`.
NOTIFICATIONS_SEND_MAX_ATTEMPTS=3
# Doubling in-process backoff between attempts: 0.5s, then 1.0s.
NOTIFICATIONS_SEND_BACKOFF_BASE_SECONDS=0.5

# --- Notification providers ---
# Resend (email): leave the key or from-address empty in dev and email
# deliveries are `skipped(not_configured)`; Slack still proceeds.
# Create a key at https://resend.com/api-keys.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=
# Slack (Web API `chat.postMessage`): a bot token with `chat:write` and the
# target channel id (e.g. `C0123456789`). Empty values skip Slack only.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# --- Identity sessions ---
SESSION_TTL_DAYS=7
# Set true outside local HTTP development (the cookie is always `HttpOnly`).
SESSION_COOKIE_SECURE=false
