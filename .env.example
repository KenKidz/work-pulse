# WorkPulse — environment template (every `app.config.Settings` key plus the
# local docker-compose infrastructure keys).
#
# The API and workers read `apps/api/.env` (they run from `apps/api`):
#   cp .env.example apps/api/.env
# Docker Compose also reads a repo-root `.env` for its variable substitution
# (POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB below):
#   cp .env.example .env
# Never commit a real `.env`; only this example is tracked. The dev-only
# infrastructure credentials here are never reused in a deployed Secret.

# --- Application ---
APP_NAME="WorkPulse API"
VERSION=0.1.0
ENVIRONMENT=development
# JSON list of allowed browser origins.
CORS_ORIGINS=["http://localhost:3000"]

# --- PostgreSQL ---
# Compose substitutes these into the dev postgres service (docker-compose.yml).
# The in-cluster Secret carries its own generated password (ops/deploy/README.md).
POSTGRES_USER=workpulse
POSTGRES_PASSWORD=workpulse
POSTGRES_DB=workpulse

# Dev database (`make db-up`) and the throwaway test database (`make db-test-up`).
DATABASE_URL=postgresql+asyncpg://workpulse:workpulse@localhost:5432/workpulse
DATABASE_TEST_URL=postgresql+asyncpg://workpulse:workpulse@localhost:5433/workpulse_test

# --- Redis (Phase 2 realtime fan-out; `make redis-up`) ---
REDIS_URL=redis://localhost:6379/0

# --- Kafka / outbox relay (Phase 3; `make kafka-up`, ADR 0012) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_EVENTS_TOPIC=workpulse.events
KAFKA_EVENTS_TOPIC_PARTITIONS=1
RELAY_BATCH_SIZE=100
RELAY_POLL_SECONDS=1.0
RELAY_BACKOFF_BASE_SECONDS=1.0
RELAY_BACKOFF_MAX_SECONDS=30.0

# --- ClickHouse analytical projection (Phase 4; `make clickhouse-up`, ADR 0019) ---
# Dev store (:8123) and the throwaway test store (`make clickhouse-test-up`,
# :8124). Tests pin `CLICKHOUSE_URL` to `CLICKHOUSE_TEST_URL`.
CLICKHOUSE_URL=http://workpulse:workpulse@127.0.0.1:8123/workpulse
CLICKHOUSE_TEST_URL=http://workpulse:workpulse@127.0.0.1:8124/workpulse_test
# ClickHouse user password. Compose hardcodes the same dev value; the in-cluster
# Secret carries a generated value (secret.example.yaml / ops/deploy/README.md).
CLICKHOUSE_PASSWORD=workpulse

# --- Employee documents object storage (`make minio-up`, ADR 0022) ---
# Private MinIO bucket; the API returns presigned URLs only. Uploads expire
# within 10 minutes and downloads within 5 (the adapter clamps both caps).
STORAGE_ENDPOINT=http://127.0.0.1:9000
STORAGE_ACCESS_KEY=workpulse
STORAGE_SECRET_KEY=workpulse
STORAGE_BUCKET=documents
STORAGE_UPLOAD_TTL_SECONDS=600
STORAGE_DOWNLOAD_TTL_SECONDS=300
# Bounded MinIO client timeouts (Phase 7, ADR 0025): the circuit breaker can
# only fail fast if one hung call is bounded; the adapter also pins botocore
# retries to one attempt so these are per-call, not per-attempt.
STORAGE_CONNECT_TIMEOUT_SECONDS=3.0
STORAGE_READ_TIMEOUT_SECONDS=5.0
# Throwaway test store (`make minio-test-up`, :9002). Tests pin STORAGE_* to
# these values before any app import.
STORAGE_TEST_ENDPOINT=http://127.0.0.1:9002
STORAGE_TEST_ACCESS_KEY=workpulse
STORAGE_TEST_SECRET_KEY=workpulse
STORAGE_TEST_BUCKET=documents-test

# --- CDC projection sink (`make dev-cdc-sink`, ADR 0024) ---
# Debezium topics are `workpulse.cdc.<table>`. The sink writes the canonical
# projection named by `CLICKHOUSE_URL` (empty = that database; the parity shadow
# was dropped at the T9 cutover). `CDC_CONNECT_URL` is the Connect REST base the
# T8 health poller reads; `CDC_SINK_METRICS_PORT` is its loopback listener.
CDC_SINK_CONSUMER_GROUP=workpulse-cdc-sink
CDC_PROJECTION_DATABASE=
CDC_CONNECT_URL=http://localhost:8083
# Connector + replication slot the health poller reads (T8); the test
# instance uses `workpulse_cdc_test`.
CDC_CONNECTOR_NAME=workpulse-cdc
CDC_SLOT_NAME=workpulse_cdc
CDC_HEALTH_POLL_SECONDS=15.0
CDC_POLL_SECONDS=1.0
CDC_BACKOFF_BASE_SECONDS=1.0
CDC_BACKOFF_MAX_SECONDS=30.0

# --- Realtime consumer (`make dev-realtime`, ADR 0013) ---
REALTIME_CONSUMER_GROUP=workpulse-realtime
REALTIME_POLL_SECONDS=1.0
REALTIME_BACKOFF_BASE_SECONDS=1.0
REALTIME_BACKOFF_MAX_SECONDS=30.0

# --- Notifications consumer + delivery (ADR 0015; worker + make target land in T5) ---
NOTIFICATIONS_CONSUMER_GROUP=workpulse-notifications
NOTIFICATIONS_POLL_SECONDS=1.0
NOTIFICATIONS_BACKOFF_BASE_SECONDS=1.0
NOTIFICATIONS_BACKOFF_MAX_SECONDS=30.0
# Provider attempts per channel (successes included) before `failed`.
NOTIFICATIONS_SEND_MAX_ATTEMPTS=3
# Doubling in-process backoff between attempts: 0.5s, then 1.0s.
NOTIFICATIONS_SEND_BACKOFF_BASE_SECONDS=0.5

# --- Notification providers ---
# Resend (email): leave the key or from-address empty in dev and email
# deliveries are `skipped(not_configured)`; Slack still proceeds.
# Create a key at https://resend.com/api-keys.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=
# Slack (Web API `chat.postMessage`): a bot token with `chat:write` and the
# target channel id (e.g. `C0123456789`). Empty values skip Slack only.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# --- Observability (Phase 6; ADR 0023) ---
# Spans are collected in-process; leave the endpoint empty to skip OTLP export
# entirely (no network call is attempted). Set it to an OTLP HTTP collector
# base URL (e.g. http://127.0.0.1:4318) to export spans.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=workpulse
# Loopback-only Prometheus listeners for the five workers (`make dev` ports).
# `0` disables the listener; tests pin every port to 0.
RELAY_METRICS_PORT=9101
REALTIME_METRICS_PORT=9102
NOTIFICATIONS_METRICS_PORT=9103
PAYROLL_METRICS_PORT=9104
CDC_SINK_METRICS_PORT=9106

# --- Reliability: circuit breakers (Phase 7; ADR 0025) ---
# Breakers wrap the relay's Kafka publish, the MinIO storage client and the
# Resend/Slack adapters. Open after N consecutive failures; try exactly one
# half-open call after the cooldown. `false` passes calls straight through.
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN_SECONDS=30.0

# --- Reliability: rate limiting (Phase 7; ADR 0025) ---
# Redis sliding window, two tiers. Auth (login/password) is keyed by client IP;
# every authenticated mutation is keyed by session user id. Reads are exempt.
# Defaults leave the e2e suite and the k6 smoke with ≥2× headroom. Redis being
# unreachable fails open (traffic proceeds); `false` disables the limiter.
RATE_LIMIT_ENABLED=true
# Immediate reverse-proxy peers whose `X-Forwarded-For` is trusted (JSON list).
# Empty ignores the header and keys the auth tier on the socket peer, so a
# client cannot rotate a spoofed header to dodge the login throttle.
RATE_LIMIT_TRUSTED_PROXIES=[]
RATE_LIMIT_AUTH_MAX_REQUESTS=30
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
RATE_LIMIT_MUTATION_MAX_REQUESTS=120
RATE_LIMIT_MUTATION_WINDOW_SECONDS=60

# --- Deployment / probes (Phase 8; ADR 0026) ---
# `GET /readyz` bounds its PostgreSQL `SELECT 1` with this timeout and answers
# 503 `dependency_unavailable` when the database is unreachable or hung.
# Liveness (`GET /healthz`) never checks dependencies.
READYZ_TIMEOUT_SECONDS=2.0
# Deployment-only strict boot check. The images and Kubernetes ConfigMap set
# this to 1, and the image smoke uses this file as its env file, so it stays
# here. `validate_boot_configuration()` reads the process environment only, so
# copying this file to `apps/api/.env` does not enable strict mode in local
# dev, tests or compose. A missing required key exits 1 with a plain-text
# `missing configuration: <KEY>` and never prints the value.
WORKPULSE_STRICT_CONFIG=1

# --- Identity sessions ---
SESSION_TTL_DAYS=7
# Set true outside local HTTP development (the cookie is always `HttpOnly`).
SESSION_COOKIE_SECURE=false
